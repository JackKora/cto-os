#!/usr/bin/env bash
# CTO OS pre-commit hook. Runs two checks when relevant files are staged:
#
#  1. validate_deps — enforces the required-dependency DAG across modules.
#     Runs whenever any modules/**/SKILL.md file is staged. Fast (sub-second
#     on ~20 modules); never skipped when scope matches.
#
#  2. skill-reviewer — qualitative review of skill, instruction, and docs
#     changes against tests/claude-review.md. The reviewer is selected by
#     CTO_OS_REVIEWER, then repo-local git config cto-os.reviewer, then auto
#     detection. Supports both the `claude` and `codex` CLIs.
#
# Enabled by:  git config core.hooksPath hooks  (done by install.sh).
# Bypass (not recommended):  git commit --no-verify

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

staged="$(git diff --cached --name-only --diff-filter=ACMRD || true)"

# Hooks must inspect the index, rather than the working tree. A developer can
# stage a change and then edit the file again before committing; checking the
# checkout in that window would approve content that is not being committed.
STAGED_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/cto-os-staged.XXXXXX")"
output_file=""
log_file=""
cleanup_hook_files() {
  rm -rf "$STAGED_ROOT"
  [[ -z "$output_file" ]] || rm -f "$output_file"
  [[ -z "$log_file" ]] || rm -f "$log_file"
}
trap cleanup_hook_files EXIT

if ! git -C "$REPO_ROOT" checkout-index --all --prefix="$STAGED_ROOT/"; then
  echo "pre-commit: couldn't materialize the staged index snapshot" >&2
  exit 1
fi

# ---------- Check 1: validate_deps ----------

staged_skills="$(echo "$staged" | grep -E '^modules/[^/]+/SKILL\.md$' || true)"

if [[ -n "$staged_skills" ]]; then
  echo "pre-commit: running validate_deps.py (module SKILL.md changes detected)"
  if ! command -v uv >/dev/null 2>&1; then
    echo "pre-commit: uv not found on PATH; cannot run validate_deps. Install uv or bypass with --no-verify." >&2
    exit 1
  fi
  deps_status=0
  deps_output="$(cd "$REPO_ROOT" && uv run --project "$STAGED_ROOT" python "$STAGED_ROOT/scripts/validate_deps.py" --args "{\"repo_root\":\"$STAGED_ROOT\"}" 2>&1)" || deps_status=$?
  if [[ $deps_status -ne 0 ]]; then
    echo "pre-commit: validate_deps.py failed (exit $deps_status):" >&2
    echo "$deps_output" >&2
    exit 1
  fi
fi

# ---------- Check 2: skill-reviewer ----------

staged_reviewable="$(echo "$staged" | grep -E '(^|/)(SKILL|CLAUDE|AGENTS)\.md$|^docs/.*\.md$|^meta/skill-reviewer\.md$|^tests/claude-review\.md$|^\.claude/agents/skill-reviewer\.md$|^\.codex/agents/skill-reviewer\.toml$' || true)"

if [[ -z "$staged_reviewable" ]]; then
  exit 0
fi

reviewer="${CTO_OS_REVIEWER:-$(git -C "$REPO_ROOT" config --local --get cto-os.reviewer || true)}"
reviewer="${reviewer:-auto}"

case "$reviewer" in
  auto)
    if command -v claude >/dev/null 2>&1; then
      reviewer="claude"
    elif command -v codex >/dev/null 2>&1; then
      reviewer="codex"
    else
      echo "pre-commit: neither claude nor codex is in PATH; skipping skill review" >&2
      exit 0
    fi
    ;;
  claude|codex) ;;
  none)
    echo "pre-commit: AI skill review disabled (reviewer=none)" >&2
    exit 0
    ;;
  *)
    echo "pre-commit: invalid reviewer '$reviewer'; expected auto, claude, codex, or none" >&2
    exit 1
    ;;
esac

if ! command -v "$reviewer" >/dev/null 2>&1; then
  echo "pre-commit: configured reviewer '$reviewer' is not in PATH; skipping skill review" >&2
  exit 0
fi

echo "pre-commit: running skill-reviewer with $reviewer on:"
echo "$staged_reviewable" | sed 's/^/  /'

files_inline="$(echo "$staged_reviewable" | tr '\n' ' ')"

prompt="You are reviewing an isolated staged Git index snapshot, not the live working checkout. Read meta/skill-reviewer.md and review these staged files against the authoritative checklist at tests/claude-review.md:

$files_inline

The review must be read-only and must end with exactly one final line: REVIEW: PASS or REVIEW: FAIL."

if [[ "$reviewer" == "claude" ]]; then
  claude_prompt="Use the skill-reviewer subagent to perform this review. Return exactly what the subagent reports.

$prompt"
  output="$(cd "$STAGED_ROOT" && claude -p "$claude_prompt" 2>&1)" || {
    echo "pre-commit: claude invocation failed" >&2
    echo "$output" >&2
    exit 1
  }
else
  output_file="$(mktemp "${TMPDIR:-/tmp}/cto-os-review-output.XXXXXX")"
  log_file="$(mktemp "${TMPDIR:-/tmp}/cto-os-review-log.XXXXXX")"
  if ! codex exec --ephemeral --sandbox read-only -C "$STAGED_ROOT" -o "$output_file" "$prompt" >"$log_file" 2>&1; then
    echo "pre-commit: codex invocation failed" >&2
    cat "$log_file" >&2
    exit 1
  fi
  output="$(cat "$output_file")"
fi

echo "$output"

if [[ "$(printf '%s\n' "$output" | tail -n 1)" == "REVIEW: PASS" ]]; then
  exit 0
fi

echo "" >&2
echo "pre-commit: skill review reported issues. Fix the FAILs above or bypass with --no-verify." >&2
exit 1
